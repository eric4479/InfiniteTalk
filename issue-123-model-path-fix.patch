+# InfiniteTalk Environment Configuration
+# Copy this file to .env and customize as needed
+
+# =============================================================================
+# Model Directory Configuration
+# =============================================================================
+
+# Base directory for all InfiniteTalk models
+# Default: ./weights (relative to project root)
+# For Runpod: /workspace/models
+# For GCP: /app/models or /mnt/models
+INFINITETALK_MODEL_DIR=./weights
+
+# ComfyUI models directory (optional, auto-detected if not set)
+# Only needed if running as ComfyUI custom node
+# For Runpod with ComfyUI: /workspace/ComfyUI/models
+COMFYUI_MODEL_DIR=
+
+# =============================================================================
+# Environment-Specific Settings
+# =============================================================================
+
+# Runpod Configuration
+# Uncomment the following for Runpod deployments:
+# INFINITETALK_MODEL_DIR=/workspace/models
+# COMFYUI_MODEL_DIR=/workspace/ComfyUI/models
+
+# Google Cloud Platform Configuration  
+# Uncomment the following for GCP deployments:
+# INFINITETALK_MODEL_DIR=/app/models
+# GCP_PROJECT=your-project-id
+
+# Local Development Configuration
+# Use default values (uncomment to override):
+# INFINITETALK_MODEL_DIR=./weights
+
+# =============================================================================
+# Model-Specific Paths (Advanced Configuration)
+# =============================================================================
+
+# Override individual model paths if needed
+# These will override the automatic path resolution
+
+# Wan base model checkpoint directory
+# WAN_BASE_DIR=${INFINITETALK_MODEL_DIR}/Wan2.1-I2V-14B-480P
+
+# Wav2Vec audio encoder directory  
+# WAV2VEC_DIR=${INFINITETALK_MODEL_DIR}/chinese-wav2vec2-base
+
+# InfiniteTalk weights file
+# INFINITETALK_WEIGHTS=${INFINITETALK_MODEL_DIR}/InfiniteTalk/single/infinitetalk.safetensors
+
+# Kokoro TTS model directory (optional)
+# KOKORO_DIR=${INFINITETALK_MODEL_DIR}/Kokoro-82M
+
+# =============================================================================
+# HuggingFace Configuration
+# =============================================================================
+
+# HuggingFace cache directory (optional)
+# HF_HOME=/workspace/.cache/huggingface
+
+# HuggingFace token for private models (if needed)
+# HF_TOKEN=your_hf_token_here
+
+# =============================================================================
+# Performance and Resource Settings
+# =============================================================================
+
+# CUDA memory management
+# PYTORCH_CUDA_ALLOC_CONF=max_split_size_mb:256
+
+# Model offloading (True/False)
+# INFINITETALK_OFFLOAD_MODEL=True
+
+# VRAM optimization
+# INFINITETALK_MAX_VRAM_GB=12
+
+# =============================================================================
+# Development and Debugging
+# =============================================================================
+
+# Print model paths on startup (True/False)
+# INFINITETALK_PRINT_PATHS=False
+
+# Enable verbose logging (True/False)  
+# INFINITETALK_VERBOSE=False
+
+# =============================================================================
+# Example Configurations by Platform
+# =============================================================================
+
+# Runpod with ComfyUI:
+# INFINITETALK_MODEL_DIR=/workspace/models
+# COMFYUI_MODEL_DIR=/workspace/ComfyUI/models
+# INFINITETALK_PRINT_PATHS=True
+
+# Google Colab:
+# INFINITETALK_MODEL_DIR=/content/models  
+# HF_HOME=/content/.cache/huggingface
+
+# Local development:
+# INFINITETALK_MODEL_DIR=./weights
+# INFINITETALK_PRINT_PATHS=True
+# INFINITETALK_VERBOSE=True
